# ============================================================================
# PALLE NATURAL FOODS - BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy to .env on your local development machine and on Hostinger
# ============================================================================

# Server Port
PORT=4000

# Security & CORS (comma separated allowed origins)
# Local: http://localhost:5173,http://localhost:3000
# Production: https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=CHANGE_ME

# Admin Authentication (MANDATORY: Minimum 12 chars for password, 32 chars for secret)
ADMIN_USER=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS
# Alternatively provide bcrypt hash:
# ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
JWT_SECRET=CHANGE_ME_MIN_32_CHARS

# Hostinger MySQL Database Configuration
# In Hostinger hPanel: Databases -> MySQL Databases
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
