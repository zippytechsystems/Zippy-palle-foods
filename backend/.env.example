# ============================================================================
# ZFRESH PRODUCTION BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and provide your production credentials
# ============================================================================

# Server Port
PORT=4000

# Security & CORS
# Comma-separated list of allowed origins (e.g. your Vercel deployment URL)
CORS_ORIGIN=https://zfresh-admin.vercel.app,http://localhost:5173,http://localhost:3000

# Admin Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=zfresh2025
TOKEN_SECRET=replace_with_a_secure_random_64_char_string_for_jwt_signing

# Supabase (PostgreSQL) Configuration
# Found in: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Use the SERVICE_ROLE key here so backend can bypass RLS securely.
# NEVER expose this key to the frontend dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
