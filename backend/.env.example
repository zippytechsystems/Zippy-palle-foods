# ============================================================================
# PALLE NATURAL FOODS - BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy to .env on your local development machine and on Hostinger
# ============================================================================

# Server Port
PORT=4000

# Security & CORS (comma separated allowed origins)
# For Hostinger production: https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Admin Authentication (Minimum 12 characters recommended)
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_to_a_secure_12plus_char_password
TOKEN_SECRET=change_this_to_a_random_64_character_hex_secret_key

# Hostinger MySQL Database Configuration
# In Hostinger hPanel: Databases -> MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_palle
DB_USER=u123456789_palleuser
DB_PASSWORD=your_strong_mysql_password_here
